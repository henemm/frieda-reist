# Startet das Einarbeiten, sobald eine Eingabe eingeht. Beobachtet nur die Anstoß-Datei der Ablage: Rückmeldedienst,
# Konnektor und Wächter schreiben sie bei jeder neuen Eingabe neu (rueckmeldungen.anstossen). Eine neue Reise braucht
# deshalb keinen Eintrag hier. Nie das Verzeichnis beobachten: status.json und aufgaben.json werden dort auch
# geschrieben und würden sonst von selbst neu auslösen.
# Erzeugt von frieda/betrieb/einrichten.sh. Läuft der Dienst schon, ist ein weiterer Start wirkungslos.
[Unit]
Description=__TITEL__: Eingabe eingegangen, Einarbeiten starten

[Path]
PathModified=__ABLAGE__/.neu
Unit=__INSTANZ__-einarbeiten.service

[Install]
WantedBy=multi-user.target

# Täglicher Lauf des Wächters und Erinnerers (__INSTANZ__-waechter.service). Er rechnet und meldet nur
# (Fristen, alte Prüfdaten, fälliger Statuswechsel); nachschlagen tut der AI-Client im Gespräch (ADR-0001).
[Unit]
Description=__TITEL__: täglich Wächter und Erinnerer

[Timer]
OnCalendar=*-*-* 07:10:00
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target

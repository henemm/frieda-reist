# Schreibweg der Instanz __INSTANZ__ (engine/schreiben.py dienst, ADR-0001 Paket O-3): Was im AI-Client über den Konnektor
# festgelegt wird (Arten und Merkmale der Reise), schreibt dieser Dienst sofort ins Reisen-Repo, prüft es mit einem Probebau,
# sichert es als Commit nach main und stößt das Veröffentlichen an. Nur für den Konnektor erreichbar (127.0.0.1, Dienst-Geheimnis).
# Erzeugt von betrieb/einrichten.sh. Code aus __DIENST__ (legt deploy.sh an); den Schreibvorgang selbst führt er mit dem
# Code der Arbeitskopie __WURZEL__-schreiben aus (ein Git-Worktree auf main, legt der Dienst an).
# git pusht mit der Anmeldung von __BENUTZER__ (gh als Credential-Helfer); sie wird nur gelesen (ProtectHome=read-only).
#
# Sandbox (#552): Der Schreibweg darf keine Dateien ändern, die später mit höheren Rechten laufen (Shell-Profile, Skripte im
# Home, die der Timer des Veröffentlichens ohne NoNewPrivileges ausführt). Schreiben darf er nur in diese Ziele, gemessen mit
# betrieb/messlauf-schreibweg.py (SCHREIBZIELE dort ist dieselbe Liste; nach jeder Änderung der Liste neu messen):
#   __WURZEL__-schreiben  Schreibkopie des Git-Wegs (Git-Worktree auf main), legt der Dienst an; „-“: darf fehlen (im
#                         Software-Klon, #454, gibt es keine Git-Reisen mehr, der Ordner entsteht dann nie)
#   __WURZEL__            Bauordner mit .git (alte Anordnung: Reisen-Repo; ab #454 der Software-Klon): Commits der Schreibkopie,
#                         Holen von main beim Veröffentlichen.
#                         Restrisiko angenommen (PO, 13.11.2026): darin liegen auch Skripte, die der Timer ohne NoNewPrivileges ausführt
#   __DIENST__            Dienstordner: Bau-Ordner der Speicher-Reisen, Sperren (FR_SPERREN), Protokolle des Veröffentlichens.
#                         Restrisiko angenommen (PO, 13.11.2026): ab #454 liegen hier auch Python-Umgebung (python/), Einstellungen und
#                         Meldeweg (instanz/), die der Timer ohne NoNewPrivileges ausführt
#   __KONTEN__            Konten-Datenbank (Einladungen, Personen der Reisen)
#   __SEITEN__            Seiten und Reisespeicher (FR_SPEICHER, Vorgabe dort): das angestoßene Veröffentlichen kopiert Seiten
#   __ABLAGE__            Rückmelde-Ablage: das Veröffentlichen legt die Ablage einer neuen Reise an
# Die Anmeldung von gh wird beim Hochladen nur gelesen; braucht ein Messlauf sie schreibend, kommt sie hier dazu.
[Unit]
Description=__TITEL__: Schreibweg (Claude-App schreibt direkt in die Reise)
After=network-online.target
Wants=network-online.target

[Service]
User=__BENUTZER__
Group=__GRUPPE__
Environment=PATH=__PFAD__
Environment=FR_WURZEL=__WURZEL__
__UMGEBUNG_DIENST__
Environment=FR_KONTEN=__KONTEN__
Environment=FR_SB_HOST=127.0.0.1
Environment=FR_SB_PORT=__SB_PORT__
EnvironmentFile=-__DIENST__/betrieb.env
EnvironmentFile=-__DIENST__/konten.env
ExecStart=__PYTHON__ __DIENST__/schreiben.py dienst
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=-/run/docker.sock
ReadWritePaths=-__WURZEL__-schreiben __WURZEL__ __DIENST__ __KONTEN__ __SEITEN__ __ABLAGE__

[Install]
WantedBy=multi-user.target

# Schreibweg der Instanz __INSTANZ__ (engine/schreiben.py dienst, ADR-0001 Paket O-3): Was im AI-Client über den Konnektor
# festgelegt wird (Arten und Merkmale der Reise), schreibt dieser Dienst sofort in den Reisespeicher, prüft es mit einem
# Probebau, sichert es und stößt das Veröffentlichen über einen Merker an (#624). Nur für den Konnektor erreichbar (127.0.0.1,
# Dienst-Geheimnis). Erzeugt von betrieb/einrichten.sh. Code aus __DIENST__ (legt deploy.sh an), auch für den Schreibvorgang
# selbst; die Arbeitskopie ist je Vorgang ein temporärer Export aus dem Speicher (#557: kein Git-Weg mehr).
#
# Sandbox (#552): Der Schreibweg darf keine Dateien ändern, die später mit höheren Rechten laufen (Shell-Profile, Skripte im
# Home, die der Timer des Veröffentlichens ohne NoNewPrivileges ausführt). Schreiben darf er nur in diese Ziele:
#   __WURZEL__            Software-Klon (#454) mit seinen Git-Daten: Holen von main beim Veröffentlichen.
#                         Restrisiko angenommen (PO, 13.11.2026): darin liegen auch Skripte, die der Timer ohne NoNewPrivileges ausführt
#   __DIENST__            Dienstordner: Bau-Ordner der Speicher-Reisen, Sperren (FR_SPERREN), Protokolle des Veröffentlichens.
#                         Restrisiko angenommen (PO, 13.11.2026): ab #454 liegen hier auch Python-Umgebung (python/), Einstellungen und
#                         Meldeweg (instanz/), die der Timer ohne NoNewPrivileges ausführt
#   __KONTEN__            Konten-Datenbank (Einladungen, Personen der Reisen)
#   __SEITEN__            Seiten und Reisespeicher (FR_SPEICHER, Vorgabe dort): das angestoßene Veröffentlichen kopiert Seiten
#   __ABLAGE__            Rückmelde-Ablage: das Veröffentlichen legt die Ablage einer neuen Reise an
[Unit]
Description=__TITEL__: Schreibweg (Claude-App schreibt direkt in die Reise)
After=network-online.target
Wants=network-online.target

[Service]
User=__BENUTZER__
Group=__GRUPPE__
Environment=PATH=__PFAD__
Environment=FR_WURZEL=__WURZEL__
__UMGEBUNG_DIENST__
Environment=FR_KONTEN=__KONTEN__
Environment=FR_SB_HOST=127.0.0.1
Environment=FR_SB_PORT=__SB_PORT__
EnvironmentFile=-__DIENST__/betrieb.env
EnvironmentFile=-__DIENST__/konten.env
ExecStart=__PYTHON__ __DIENST__/schreiben.py dienst
Restart=on-failure
RestartSec=5
# Speichergrenzen (#538): weiche Drossel (MemoryHigh), harte Grenze (MemoryMax), Swap eigens begrenzt (MemorySwapMax).
# Messung vom 17.11.2026: höchste Spitze der letzten 60 Tage 3,4 GiB, verursacht vom Veröffentlichen als Kindprozess in dieser
# cgroup. Seit #624 legt der Schreibweg nur noch den Merker __DIENST__/veroeffentlichen-anstoss, das Veröffentlichen läuft als
# eigener Dienst (__INSTANZ__-veroeffentlichen.path startet __INSTANZ__-veroeffentlichen.service); ohne Kindprozess reichen 512M,
# Swap wie beim Konnektor eng (256M), damit ein Leck begrenzt statt verschleppt wird.
# Nachmessen: Journalzeile „memory peak“ des Dienstes (journalctl -u __INSTANZ__-schreiben), Anleitung in docs/betrieb.md.
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=256M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=-/run/docker.sock
ReadWritePaths=__WURZEL__ __DIENST__ __KONTEN__ __SEITEN__ __ABLAGE__

[Install]
WantedBy=multi-user.target

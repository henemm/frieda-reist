# Container des eigenen Kartendienstes (#444): Overpass-Image, per Digest gepinnt (ein Update des Images ändert nichts ungeprüft),
# Daten aus __KD_ORDNER__ (betrieb/kartendienst.sh einspielen). Startet nur über den Proxy und endet mit ihm
# (StopWhenUnneeded). Bereit ist er erst, wenn eine echte Mini-Abfrage gültig antwortet (ExecStartPost; der Statusaufruf des
# Images taugt dafür nicht). Lizenzen: Overpass AGPL, Daten ODbL (docs/betrieb.md, THIRD_PARTY.md).
# Erzeugt von betrieb/einrichten.sh. __BENUTZER__ braucht die Gruppe docker.
[Unit]
Description=__TITEL__: eigener Kartendienst (Overpass-Container)
StopWhenUnneeded=yes
Requires=docker.service
After=docker.service

[Service]
User=__BENUTZER__
Group=__GRUPPE__
ExecStartPre=/usr/bin/test -f __KD_ORDNER__/init_done
ExecStartPre=-/usr/bin/docker rm -f __INSTANZ__-kartendienst
ExecStart=/usr/bin/docker run --rm --name __INSTANZ__-kartendienst --memory __KD_SPEICHER__ -p 127.0.0.1:__KD_PORT_INNEN__:80 -e OVERPASS_MODE=init -e OVERPASS_META=no -e OVERPASS_USE_AREAS=false -v __KD_ORDNER__:/db __KD_BILD__
ExecStartPost=/usr/bin/curl -fsS -o /dev/null --retry 30 --retry-delay 1 --retry-all-errors --retry-max-time 60 --max-time 10 --data-urlencode "data=[out:json];node(1);out ids;" http://127.0.0.1:__KD_PORT_INNEN__/api/interpreter
ExecStop=/usr/bin/docker stop __INSTANZ__-kartendienst
TimeoutStartSec=90

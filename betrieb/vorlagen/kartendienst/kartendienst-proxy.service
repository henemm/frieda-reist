# Proxy des eigenen Kartendienstes (#444): reicht den Verkehr vom Socket an den Container weiter und endet nach der Ruhezeit
# ohne Verkehr (--exit-idle-time); mit ihm endet der Container (BindsTo, StopWhenUnneeded). Erzeugt von frieda/betrieb/einrichten.sh.
[Unit]
Description=__TITEL__: eigener Kartendienst (Proxy, endet nach der Ruhezeit)
Requires=__INSTANZ__-kartendienst.socket
BindsTo=__INSTANZ__-kartendienst.service
After=__INSTANZ__-kartendienst.socket __INSTANZ__-kartendienst.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=__KD_RUHE__ 127.0.0.1:__KD_PORT_INNEN__
PrivateTmp=yes
NoNewPrivileges=yes

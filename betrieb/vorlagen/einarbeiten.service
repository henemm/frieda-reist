# Rückmeldungen automatisch einarbeiten und veröffentlichen (frieda/betrieb/einarbeiten.sh). Gestartet vom Pfad-Wächter
# (__INSTANZ__-einarbeiten.path, sofort nach einer Eingabe) und stündlich vom Timer (Sicherheitsnetz).
# Erzeugt von frieda/betrieb/einrichten.sh. Log: journalctl -u __INSTANZ__-einarbeiten -n 100
# Claude Code läuft mit der Anmeldung von __BENUTZER__ (~/.claude), gh mit dessen GitHub-Zugang.
[Unit]
Description=__TITEL__: Rückmeldungen automatisch einarbeiten
After=network-online.target
Wants=network-online.target
# Keine Start-Begrenzung: Eingaben dürfen so oft auslösen, wie sie kommen; ohne Neues startet keine KI
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=__BENUTZER__
Group=__GRUPPE__
Environment=PATH=__PFAD__
Environment=FR_WURZEL=__WURZEL__
EnvironmentFile=-__DIENST__/betrieb.env
EnvironmentFile=-__DIENST__/konten.env
ExecStart=__WURZEL__/frieda/betrieb/einarbeiten.sh
# Obergrenze für 3 Durchgänge: je 20 min Sammelzeit + KI-Läufe + 15 min Veröffentlichen
TimeoutStartSec=6h

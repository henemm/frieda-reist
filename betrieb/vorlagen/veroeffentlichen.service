# Automatisch veröffentlichen (betrieb/veroeffentlichen.sh), gestartet vom Timer daneben.
# Erzeugt von betrieb/einrichten.sh. Log: journalctl -u __INSTANZ__-veroeffentlichen -n 50
# Kein NoNewPrivileges: deploy.sh startet geänderte Dienste mit sudo -n neu, freischalten.sh lädt nginx neu.
[Unit]
Description=__TITEL__: automatisch veröffentlichen
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__BENUTZER__
Group=__GRUPPE__
Environment=PATH=__PFAD__
Environment=FR_WURZEL=__WURZEL__
__UMGEBUNG_DIENST__
# Geheime Werte (Heartbeat, Meldeweg) und Konten, Dateien 600, nicht im Repo
EnvironmentFile=-__DIENST__/betrieb.env
EnvironmentFile=-__DIENST__/konten.env
ExecStart=__SOFTWARE__/betrieb/veroeffentlichen.sh
# Die Tests brauchen Minuten an Rechenzeit; Schreibvorgänge des Schreibwegs gehen vor
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Zeitgrenze für Tests der Software, Bau und Deploy in einem Lauf: die Tests allein brauchen in CI 16 bis 19 Minuten,
# auf dem Server mit Nice=10 und Last länger (#258). Der Timer startet keinen zweiten Lauf, solange einer läuft.
TimeoutStartSec=45min
